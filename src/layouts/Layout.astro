---
import Header from '../components/Header.tsx'
import Nav from '../components/Nav.tsx'
import Footer from '../components/Footer.tsx'
interface Props {
  title: string
  description?: string
  image?: string
  canonicalURL?: string
}

const {
  title,
  description = "Aleix Martínez Peña — Product-focused full-stack developer. Vue/Nuxt, Node.js, TypeScript and PostgreSQL. Open to frontend and full-stack roles in product teams.",
  image = '/favicon.svg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href
} = Astro.props

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aleix Martínez Peña',
  jobTitle: 'Full-stack Developer',
  url: Astro.site,
  sameAs: [
    'https://github.com/Aleix1379',
    'https://www.linkedin.com/in/aleixmp'
  ]
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/favicon_io/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:site_name" content="Aleix Martínez Peña — Full-stack Developer" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site).href} />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />
  </head>
  <body data-theme="dark">
    <div class="container">
      <Header />
      <Nav client:load />
      <slot />
      <Footer client:visible />
    </div>
  </body>
</html>
<style is:global>
  @import '../styles/colors.css';
  @import '../styles/variables.css';

  @font-face {
    font-family: 'Catamaran';
    src: url('/fonts/Catamaran/Catamaran-VariableFont_wght.ttf');
    font-display: swap;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  * {
    box-sizing: border-box;
  }

  *::selection {
    color: var(--on-accent);
    background: rgba(76, 221, 156, 0.85);
  }

  html,
  body {
    padding: 0;
    margin: 0;
    min-width: 320px;
    font-family:
      'Catamaran',
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    background: var(--background);
  }

  html {
    scroll-behavior: smooth;
    scroll-padding: var(--scroll-anchor-offset);
  }

  body {
    color: var(--text-color);
    min-height: 100vh;
    overflow-x: hidden;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  button,
  a,
  input,
  textarea {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  body::-webkit-scrollbar {
    width: 12px;
  }

  body::-webkit-scrollbar-track {
    background-color: var(--background);
  }

  body::-webkit-scrollbar-thumb {
    background: rgba(219, 255, 238, 0.16);
    border: 3px solid var(--background);
    border-radius: 999px;
  }

  .container {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: hidden;
    color: var(--text-color);
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(
        circle at top left,
        rgba(56, 193, 136, 0.06),
        transparent 42rem
      ),
      var(--background);
    transition:
      background-color 0.35s ease,
      color 0.35s ease;
  }

  .container > * {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
