---
import Nav from '../components/Nav.tsx';
import Footer from '../components/Footer.tsx';
import '../styles/globals.css';
interface Props {
	title: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
}

const {
	title,
	description = "Aleix Martínez Pena — Full-stack developer building web and mobile products, backend services and applications from development to deployment.",
	image = "/images/about-aleix.webp",
	canonicalURL = new URL(Astro.url.pathname, Astro.site).href
} = Astro.props;

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Aleix Martínez Pena",
	"jobTitle": "Full-stack Developer",
	"url": Astro.site,
	"sameAs": [
		"https://github.com/Aleix1379",
		"https://www.linkedin.com/in/aleixmp"
	]
};
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			try {
				const saved = localStorage.getItem('portfolio-theme') ?? localStorage.getItem('data-theme');
				if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
			} catch { /* The server-rendered dark theme remains usable without storage. */ }
		</script>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark light" />
		<link rel="preload" href="/fonts/Geist/Geist.woff2" as="font" type="font/woff2" crossorigin />
		<title>{title}</title>

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

		<!-- Robots -->
		<meta name="robots" content="index, follow" />
	</head>
	<body data-theme="dark">
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Nav client:load />
		<slot />
		<Footer />
	</body>
</html>
