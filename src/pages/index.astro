---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.tsx'
import AboutSection from '../sections/AboutSection.tsx'
import ExperienceSection from '../sections/ExperienceSection.tsx'
import ProjectsSection from '../sections/ProjectsSection.tsx'
import ContactSection from '../sections/ContactSection.tsx'
---

<Layout
  title="Aleix Martínez Pena — Full-stack developer"
  description="Full-stack developer building web and mobile products. Explore Arcblink, Race Tracker and WishFetch, my experience, and how to get in touch."
  image="/images/about-aleix.webp"
>
  <main id="main-content" tabindex="-1">
    <Header client:load />
    <ProjectsSection client:visible />
    <ExperienceSection client:visible />
    <AboutSection />
    <ContactSection client:visible />
  </main>

</Layout>
