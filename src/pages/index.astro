---
import Layout from '../layouts/Layout.astro'
import AboutSection from '../sections/AboutSection.tsx'
import ExperienceSection from '../sections/ExperienceSection.tsx'
import ProjectsSection from '../sections/ProjectsSection.tsx'
---

<Layout
  title="Aleix - Full-stack Developer Portfolio"
  description="Aleix Martínez Peña — Full-stack web developer for product applications. Vue/Nuxt, Node.js, TypeScript and PostgreSQL. Open to frontend and full-stack roles in product teams."
  image="/images/about-developer-workspace.webp"
>
  <main class="main">
    <AboutSection client:visible />
    <ExperienceSection client:visible />
    <ProjectsSection client:visible />
  </main>

  <style>
    .main {
      width: 100%;
      align-self: center;
      padding: 24px 20px 0;
    }

    @media (min-width: 768px) {
      .main {
        padding: 48px 24px 0;
      }
    }
  </style>
</Layout>
