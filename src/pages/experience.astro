---
import Layout from '../layouts/Layout.astro'
import ExperienceSection from '../sections/ExperienceSection.tsx'
---

<Layout
  title="Experience — Aleix Martínez Pena, Full-stack Web Developer"
  description="Explore the professional experience of Aleix Martínez Pena across product web, eCommerce and full-stack development roles."
>
  <main class="main">
    <ExperienceSection client:visible />
  </main>

  <style>
    .main {
      width: 100%;
      align-self: center;
      padding: 24px 20px 0;
    }

    @media (min-width: 768px) {
      .main {
        padding: 48px 24px 0;
      }
    }
  </style>
</Layout>
